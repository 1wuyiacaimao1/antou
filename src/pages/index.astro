---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";
import site from "../data/site";

const all = (await getCollection("journal", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const recent = all.slice(0, 3);

const momentList = await getCollection("moments", ({ data }) => !data.draft);
const shotCount = momentList.reduce((n, m) => n + m.data.photos.length, 0);

const noteCount = (await getCollection("notes", ({ data }) => !data.draft)).length;
const listCount = (await getCollection("lists", ({ data }) => !data.draft)).length;

const pad = (n: number) => String(n).padStart(2, "0");
const md = (d: Date) => `${d.getMonth() + 1}.${pad(d.getDate())}`;
const full = (d: Date) => `${d.getFullYear()} · ${pad(d.getMonth() + 1)} · ${pad(d.getDate())}`;
const today = new Date();
const weekday = ["日", "一", "二", "三", "四", "五", "六"][today.getDay()];
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<Base title={site.brand}>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <filter id="wobble" x="-10%" y="-10%" width="120%" height="120%">
        <feTurbulence type="fractalNoise" baseFrequency="0.055" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
  </svg>

  <div class="stage">
    <div class="table">
      <!-- 水杯 -->
      <svg class="deco glass" viewBox="0 0 80 80" aria-hidden="true">
        <circle cx="40.4" cy="39.6" r="27" fill="var(--glass-fill)" />
        <circle cx="39.7" cy="40.6" r="22.7" fill="var(--water)" />
        <circle cx="40.4" cy="39.6" r="27" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1.2" />
        <circle cx="39.7" cy="40.6" r="22.7" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1" opacity=".55" />
        <path d="M23 29 A19 19 0 0 1 31 21.5" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1.1" opacity=".45" stroke-linecap="round" />
      </svg>

      <!-- 盆栽 -->
      <svg class="deco plant" viewBox="0 0 110 110" aria-hidden="true">
        <ellipse cx="55" cy="55.6" rx="46.6" ry="45" fill="var(--pot)" />
        <ellipse cx="55" cy="56" rx="38.3" ry="37.2" fill="#A08D74" />
        <g>
          <ellipse cx="54.5" cy="28.5" rx="13.6" ry="6.3" transform="rotate(5 54.5 28.5)" fill="var(--leaf)" />
          <ellipse cx="54.5" cy="28.5" rx="13.6" ry="6.3" transform="rotate(5 54.5 28.5)" class="out" />
          <ellipse cx="77.6" cy="40" rx="12.1" ry="6.9" transform="rotate(64 77.6 40)" fill="var(--leaf-2)" />
          <ellipse cx="77.6" cy="40" rx="12.1" ry="6.9" transform="rotate(64 77.6 40)" class="out" />
          <ellipse cx="79.4" cy="66.6" rx="13.4" ry="5.9" transform="rotate(119 79.4 66.6)" fill="var(--leaf)" />
          <ellipse cx="79.4" cy="66.6" rx="13.4" ry="5.9" transform="rotate(119 79.4 66.6)" class="out" />
          <ellipse cx="55.6" cy="81.6" rx="11.1" ry="5.5" transform="rotate(173 55.6 81.6)" fill="var(--leaf-2)" />
          <ellipse cx="55.6" cy="81.6" rx="11.1" ry="5.5" transform="rotate(173 55.6 81.6)" class="out" />
          <ellipse cx="30.8" cy="70.2" rx="13.5" ry="6.7" transform="rotate(237 30.8 70.2)" fill="var(--leaf)" />
          <ellipse cx="30.8" cy="70.2" rx="13.5" ry="6.7" transform="rotate(237 30.8 70.2)" class="out" />
          <ellipse cx="29.4" cy="40.8" rx="12" ry="6.1" transform="rotate(299 29.4 40.8)" fill="var(--leaf-2)" />
          <ellipse cx="29.4" cy="40.8" rx="12" ry="6.1" transform="rotate(299 29.4 40.8)" class="out" />
        </g>
        <ellipse cx="55.4" cy="55.2" rx="6.2" ry="5.7" fill="#8C7A60" />
        <ellipse cx="55" cy="55.6" rx="46.6" ry="45" class="out" />
        <ellipse cx="55" cy="56" rx="38.3" ry="37.2" class="out" opacity=".5" />
      </svg>

      <!-- 笔：点击写一条 -->
      <svg class="deco pen" id="penBtn" viewBox="0 0 160 26" aria-hidden="true" role="button" tabindex="0">
        <rect x="6" y="9" width="112" height="8" rx="4" fill="var(--pen)" />
        <rect x="6" y="9" width="112" height="8" rx="4" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1.2" />
        <rect x="2" y="8.5" width="40" height="9" rx="4.5" fill="#D3C7B2" />
        <rect x="2" y="8.5" width="40" height="9" rx="4.5" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1.2" />
        <path d="M118 9 L136 13 L118 17 Z" fill="#C6B79E" />
        <path d="M118 9 L136 13 L118 17 Z" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1.2" />
        <path d="M2 8.5 V17.5" fill="none" stroke="rgba(34,22,12,.62)" stroke-width="1.2" />
        <rect x="0" y="0" width="160" height="26" fill="transparent" pointer-events="all" />
      </svg>
      <span class="pen-hint" id="penHint">写一条</span>

      <div class="notes">
        <div class="note note-big">
          <div class="status">{site.status}</div>
          <span class="date">{full(today)} · 星期{weekday}</span>
        </div>

        <div class="note note-small">
          <div class="cap">桌 上</div>
          {
            recent.map((e) => (
              <a class="row" href={`${base}journal/${e.id}`}>
                <span class="d">{md(e.data.date)}</span>
                <span class="t">{e.data.title || "无题"}</span>
              </a>
            ))
          }
          {recent.length === 0 && <a class="row" href={`${base}journal`}><span class="d">—</span><span class="t">还没有记录</span></a>}
        </div>
      </div>

      <button class="shuffle">翻旧账</button>
    </div>

    <script type="application/json" id="all-entries" set:html={JSON.stringify(all.map((e) => `${base}journal/${e.id}`))} />

    <div class="scene">
      <!-- 左下角地板：两本书、便签、平躺的小玩偶 -->
      <svg class="floor-obj things" viewBox="0 0 300 210" aria-hidden="true">
        <g transform="rotate(-6 90 140)">
          <rect x="8" y="96" width="172" height="92" rx="4" fill="#B9A488" />
          <rect x="8" y="96" width="11" height="92" fill="#9E8A6E" />
          <rect x="8" y="184" width="172" height="4" fill="#E6DCC8" />
          <rect x="8" y="96" width="172" height="92" rx="4" class="out" />
        </g>
        <g transform="rotate(7 112 88)">
          <rect x="40" y="46" width="152" height="84" rx="4" fill="#D8CBB5" />
          <rect x="40" y="46" width="10" height="84" fill="#C3B096" />
          <rect x="40" y="126" width="152" height="4" fill="#F0E8D8" />
          <rect x="40" y="46" width="152" height="84" rx="4" class="out" />
          <path d="M64 70 H162" class="thin" />
        </g>
        <g transform="rotate(13 254 160)">
          <rect x="232" y="138" width="44" height="44" rx="2" fill="#F1E9D6" />
          <rect x="232" y="138" width="44" height="44" rx="2" class="out" />
        </g>

        <!-- 平躺的小玩偶 -->
        <g transform="translate(214 30) scale(.44)" stroke-linejoin="round" stroke-linecap="round">
          <ellipse cx="28" cy="76" rx="9" ry="15" transform="rotate(-14 28 76)" fill="#E9D8C6" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <ellipse cx="92" cy="76" rx="9" ry="15" transform="rotate(14 92 76)" fill="#E9D8C6" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <ellipse cx="50" cy="126" rx="8" ry="12" fill="#EFE1D2" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <ellipse cx="70" cy="126" rx="8" ry="12" fill="#EFE1D2" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <path d="M60 54 C74 54 80 66 82 84 L84 112 C84 120 76 124 60 124 C44 124 36 120 36 112 L38 84 C40 66 46 54 60 54 Z" fill="#DCCAB6" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <path d="M46 86 C54 90 66 90 74 86" fill="none" stroke="rgba(140,105,80,.26)" stroke-width="1.6" />
          <path d="M42 104 C52 109 68 109 78 104" fill="none" stroke="rgba(140,105,80,.26)" stroke-width="1.6" />
          <path d="M60 62 L60 92" fill="none" stroke="rgba(140,105,80,.18)" stroke-width="1.6" />
          <path d="M40 114 C50 119 70 119 80 114" fill="none" stroke="rgba(120,92,72,.42)" stroke-width="1.5" stroke-dasharray="3 3" />
          <circle cx="60" cy="38" r="21" fill="#F2E4D5" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <circle cx="39" cy="22" r="9" fill="#C09A8A" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <circle cx="81" cy="22" r="9" fill="#C09A8A" stroke="rgba(90,70,55,.40)" stroke-width="1.6" />
          <path d="M40 32 C46 20 74 20 80 32" fill="none" stroke="rgba(90,70,55,.32)" stroke-width="1.4" />
          <path d="M50 38 Q53 41 56 38" fill="none" stroke="rgba(110,80,62,.55)" stroke-width="1.6" />
          <path d="M64 38 Q67 41 70 38" fill="none" stroke="rgba(110,80,62,.55)" stroke-width="1.6" />
          <path d="M56 47 Q60 50 64 47" fill="none" stroke="rgba(110,80,62,.55)" stroke-width="1.6" />
          <ellipse cx="47" cy="45" rx="4.5" ry="3" fill="#E0B4A8" opacity=".35" />
          <ellipse cx="73" cy="45" rx="4.5" ry="3" fill="#E0B4A8" opacity=".35" />
          <path d="M41 46 C36 54 40 60 48 61" fill="none" stroke="rgba(120,92,72,.42)" stroke-width="1.5" stroke-dasharray="3 3" />
          <g transform="translate(84 20) rotate(18)">
            <path d="M0 0 L-9 -5 L-9 5 Z" fill="#CE9F99" stroke="rgba(120,80,72,.55)" stroke-width="1.3" />
            <path d="M0 0 L9 -5 L9 5 Z" fill="#CE9F99" stroke="rgba(120,80,72,.55)" stroke-width="1.3" />
            <circle cx="0" cy="0" r="2.6" fill="#B98A84" stroke="rgba(120,80,72,.55)" stroke-width="1.3" />
          </g>
        </g>
      </svg>

      <!-- 右下角：办公转椅，朝向左上 -->
      <svg class="floor-obj chair" viewBox="-16 -8 272 300" aria-hidden="true">
        <defs>
          <g id="arm">
            <path d="M-6 -12 L-9 -74 L9 -74 L6 -12 Z" fill="#6A6056" />
            <path d="M-6 -12 L-9 -74 L9 -74 L6 -12 Z" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" stroke-linejoin="round" />
            <ellipse cx="0" cy="-82" rx="9" ry="6.5" fill="#4E463D" />
            <ellipse cx="0" cy="-82" rx="9" ry="6.5" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" />
          </g>
        </defs>

        <g transform="rotate(135 120 150)">
          <g transform="translate(120 154)">
            <use href="#arm" transform="rotate(0) scale(1.01)" />
            <use href="#arm" transform="rotate(71) scale(0.985)" />
            <use href="#arm" transform="rotate(146) scale(1.015)" />
            <use href="#arm" transform="rotate(217) scale(0.99)" />
            <use href="#arm" transform="rotate(290) scale(1.005)" />
            <circle cx="0" cy="0" r="14" fill="#5E554B" />
            <circle cx="0" cy="0" r="14" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" />
          </g>

          <path d="M46 98 Q120 44 194 98 L194 116 Q120 72 46 116 Z" fill="#6F6459" />
          <path d="M46 98 Q120 44 194 98 L194 116 Q120 72 46 116 Z" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" stroke-linejoin="round" />

          <ellipse cx="46" cy="146" rx="15" ry="40" fill="#7A6F63" />
          <ellipse cx="46" cy="146" rx="15" ry="40" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" />
          <ellipse cx="194" cy="146" rx="15" ry="40" fill="#7A6F63" />
          <ellipse cx="194" cy="146" rx="15" ry="40" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" />

          <rect x="62" y="96" width="116" height="108" rx="30" fill="#8B8074" />
          <rect x="62" y="96" width="116" height="108" rx="30" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" />
          <path d="M80 138 Q120 150 160 138" fill="none" stroke="rgba(52,40,28,.48)" stroke-width="1.1" opacity=".3" />
        </g>
      </svg>

      <!-- 抽屉 -->
      <div class="drawer">
        <div class="tray" id="tray">
          <div class="tray-inner">
            <a class="cell" href={`${base}journal`}><span class="name">随记</span><span class="count">{all.length} 条</span><span class="stack"><i></i><i></i></span></a>
            <a class="cell" href={`${base}moments`}><span class="name">瞬间</span><span class="count">{shotCount > 0 ? `${shotCount} 张` : "先空着"}</span><span class="stack"><i></i><i></i></span></a>
            <a class="cell" href={`${base}lists`}><span class="name">清单</span><span class="count">{listCount > 0 ? `${listCount} 个` : "先空着"}</span><span class="stack"><i></i><i></i></span></a>
            <a class="cell" href={`${base}notes`}><span class="name">笔记</span><span class="count">{noteCount > 0 ? `${noteCount} 篇` : "先空着"}</span><span class="stack"><i></i><i></i></span></a>
            <a class="cell" href={`${base}bookmarks`}><span class="name">收藏</span><span class="count">先空着</span><span class="stack"><i></i><i></i></span></a>
          </div>
        </div>
        <div class="bar" id="bar">
          <span class="handle"></span>
          <span class="word">抽屉</span>
          <span class="hint">往下拉</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    // 抽屉：拖拽 + 点击
    (function () {
      const tray = document.getElementById("tray")!;
      const bar = document.getElementById("bar")!;
      const MAX = 164, DAMP = 0.6, THRESH = 60, VEL = 0.5;
      let startY = 0, startH = 0, lastY = 0, lastT = 0, vy = 0, dragging = false, moved = 0;

      const isOpen = () => tray.offsetHeight > MAX * 0.5;
      function settle(open: boolean) {
        tray.style.transition = "height .3s cubic-bezier(.22,.61,.36,1)";
        tray.style.height = open ? MAX + "px" : "0px";
      }

      bar.addEventListener("pointerdown", (e) => {
        dragging = true; startY = lastY = e.clientY;
        lastT = performance.now(); startH = tray.offsetHeight; vy = 0; moved = 0;
        tray.style.transition = "none";
        bar.setPointerCapture(e.pointerId);
      });
      bar.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dy = (e.clientY - startY) * DAMP;
        const now = performance.now(), dt = Math.max(now - lastT, 1);
        vy = (e.clientY - lastY) / dt;
        lastY = e.clientY; lastT = now;
        moved = Math.max(moved, Math.abs(e.clientY - startY));
        tray.style.height = Math.min(Math.max(startH + dy, 0), MAX) + "px";
      });
      bar.addEventListener("pointerup", (e) => {
        if (!dragging) return;
        dragging = false;
        const dy = (e.clientY - startY) * DAMP;
        if (moved < 6) settle(!isOpen());
        else if (dy > THRESH || vy > VEL) settle(true);
        else if (dy < -THRESH || vy < -VEL) settle(false);
        else settle(startH > MAX * 0.5);
        bar.releasePointerCapture(e.pointerId);
      });
      bar.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); settle(!isOpen()); }
      });
      bar.tabIndex = 0;
    })();

    // 翻旧账：随机抽一条旧的
    (function () {
      const btn = document.querySelector<HTMLButtonElement>(".shuffle");
      const data = document.getElementById("all-entries");
      if (!btn || !data) return;
      let list: string[] = [];
      try { list = JSON.parse(data.textContent || "[]"); } catch { list = []; }
      btn.addEventListener("click", () => {
        if (list.length === 0) return;
        const pick = list[Math.floor(Math.random() * list.length)];
        window.location.href = pick;
      });
    })();

    // 点笔写一条
    (function () {
      const REPO = "OWNER/REPO"; // 换成你的仓库，例如 wuyi/wuyi.github.io
      const PATH = "src/content/journal";
      const pen = document.getElementById("penBtn")!;
      const hint = document.getElementById("penHint")!;
      const pad = (n: number) => (n < 10 ? "0" + n : "" + n);

      function open() {
        const d = new Date();
        const ymd = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
        if (REPO.indexOf("OWNER") === 0) {
          hint.textContent = "还没接仓库";
          hint.classList.add("on");
          setTimeout(() => hint.classList.remove("on"), 2200);
          return;
        }
        const tpl = [
          "---",
          "date: " + ymd + " " + pad(d.getHours()) + ":" + pad(d.getMinutes()),
          "title: ",
          "tags: []",
          "draft: true",
          "---",
          "",
          "",
        ].join("\n");
        const url =
          "https://github.com/" + REPO + "/new/main/" + PATH + "/" + ymd +
          ".md?filename=" + encodeURIComponent(ymd + ".md") +
          "&value=" + encodeURIComponent(tpl);
        window.open(url, "_blank", "noopener");
      }

      pen.addEventListener("click", open);
      pen.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); }
      });
    })();
  </script>
</Base>

<style is:global>
  .stage{
    width: min(1280px, 100%);
    min-height: 100vh;
    margin: 0 auto;
    padding: 26px;
    display: flex;
    flex-direction: column;
  }

  .table{
    position: relative;
    height: 52vh;
    min-height: 400px;
    border-radius: 14px;
    padding: 40px 46px 0;
    background-color: var(--wood);
    background-image:
      var(--grain),
      radial-gradient(140% 100% at 22% -12%, rgba(255,236,208,.10), rgba(255,236,208,0) 60%),
      radial-gradient(100% 80% at 92% 112%, rgba(0,0,0,.30), rgba(0,0,0,0) 68%);
    background-size: 100% 100%, 100% 100%, 100% 100%;
    background-repeat: no-repeat;
    box-shadow:
      inset 0 -5px 0 var(--wood-edge),
      inset 0 -7px 10px -6px rgba(0,0,0,.55),
      0 1px 0 rgba(0,0,0,.22),
      0 30px 58px -24px rgba(20,12,6,.60);
  }

  .deco{
    position: absolute;
    pointer-events: none;
    filter: url(#wobble) drop-shadow(4px 9px 11px rgba(20,12,6,.45));
  }
  .deco .out{
    fill: none;
    stroke: rgba(34,22,12,.62);
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .deco.pen{
    pointer-events: auto;
    cursor: pointer;
    transition: transform .18s ease, filter .18s ease;
  }
  .deco.pen:hover{
    transform: rotate(-14deg) translateY(-4px);
    filter: url(#wobble) drop-shadow(7px 14px 16px rgba(20,12,6,.55));
  }
  .pen-hint{
    position: absolute;
    right: 46px;
    bottom: 104px;
    pointer-events: none;
    font-size: 11px;
    letter-spacing: .12em;
    color: var(--wood-text-2);
    opacity: 0;
    transition: opacity .18s ease;
  }
  .pen-hint.on{ opacity: 1; }
  .deco.pen:hover + .pen-hint{ opacity: 1; }

  .glass{ left: 44px; top: 110px; width: 64px; }
  .plant{ right: 40px; top: 6px; width: 100px; }
  .pen{ right: 46px; bottom: 86px; width: 124px; transform: rotate(-16deg); }

  .notes{ width: min(600px, 100%); margin: 6px auto 0; }
  .note{
    background: var(--paper);
    position: relative;
    box-shadow: 0 2px 6px rgba(0,0,0,.28), 0 16px 34px rgba(0,0,0,.30);
  }
  .note-big{
    width: min(540px, 100%);
    margin: 0 auto;
    padding: 42px 44px 38px;
    transform: rotate(-1.1deg);
    text-align: center;
  }
  .status{
    font-family: var(--brush);
    font-size: clamp(44px, 5vw, 70px);
    line-height: 1.18;
    letter-spacing: .02em;
    transform: rotate(-.4deg);
    text-shadow: 0 1px 0 rgba(31,30,27,.06), 0 8px 16px rgba(31,30,27,.10);
  }
  .date{
    display: block;
    font-size: 11px;
    letter-spacing: .22em;
    color: var(--ink-2);
    margin-top: 14px;
  }

  .note-small{
    width: 292px;
    margin: 16px 0 0 auto;
    padding: 18px 20px 14px;
    transform: rotate(1.4deg);
  }
  .cap{
    font-size: 10px;
    letter-spacing: .22em;
    color: #A8A39A;
    margin-bottom: 8px;
  }
  .row{
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 10px;
    padding: 5px 0;
    align-items: baseline;
    text-decoration: none;
  }
  .row .d{
    font-family: var(--brush);
    font-size: 14px;
    color: var(--ink-2);
    transition: color .18s;
  }
  .row .t{ font-size: 13px; line-height: 1.5; color: #33312D; }
  .row:hover .d{ color: var(--stamp); }

  .shuffle{
    position: absolute;
    left: 46px;
    bottom: 40px;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--wood-hi);
    background-image: var(--grain);

---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { parseItems, countDone } from "../../lib/lists";

const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";

const rows = (await getCollection("lists", ({ data }) => !data.draft))
  .sort((a, b) => a.id.localeCompare(b.id))
  .map((l) => {
    const items = parseItems(l.body ?? "");
    const done = countDone(items);
    return {
      id: l.id,
      name: l.data.name,
      note: l.data.note,
      total: items.length,
      done,
      pct: items.length ? Math.round((done / items.length) * 100) : 0,
    };
  });
---

<Base title="清单">
  <div class="sheet-page">
    <div class="sheet">
      <a class="back" href={base}>← 书桌</a>

      <div class="head">
        <h1>清单</h1>
        <span class="count">{rows.length > 0 ? `${rows.length} 个` : "还是空的"}</span>
      </div>
      <p class="lede">想做的事分门别类放着，勾掉一项就算完成，不追进度。</p>

      {
        rows.length === 0 ? (
          <div class="empty">
            <p>还没有清单。</p>
            <p class="sub">桌面上双击「2-写一条」，选「清单」，一行写一项。</p>
          </div>
        ) : (
          <div class="lists">
            {rows.map((l) => (
              <a class="row-link" href={`${base}lists/${l.id}`}>
                <span class="top">
                  <span class="name">{l.name}</span>
                  <span class="num">{l.done} / {l.total}</span>
                </span>
                <div class="note">{l.note}</div>
                <div class="track"><i style={`width:${l.pct}%`} /></div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</Base>

<style is:global>
  .lists{ margin-top: 34px; }

  .row-link{
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .row-link:last-child{ border-bottom: 1px solid var(--line); }
  .row-link .top{ display: flex; align-items: baseline; gap: 14px; }
  .row-link .name{ font-size: 16.5px; line-height: 1.6; }
  .row-link .num{ margin-left: auto; font-family: var(--brush); font-size: 14px; color: var(--ink-2); }
  .row-link .note{ margin-top: 5px; font-size: 12.5px; color: #A8A39A; letter-spacing: .02em; }
  .row-link:hover .num{ color: var(--stamp); }

  .track{ margin-top: 12px; height: 2px; background: var(--line); position: relative; overflow: hidden; }
  .track i{ position: absolute; left: 0; top: 0; bottom: 0; background: #8C8272; transition: width .3s cubic-bezier(.22,.61,.36,1); }

  .empty{ margin-top: 70px; font-family: var(--brush); font-size: 20px; color: #C0B7A6; line-height: 2; }
  .empty .sub{ font-size: 15px; color: #C8BFAD; }
</style>

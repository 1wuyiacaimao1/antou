---
import Base from "../layouts/Base.astro";
import { groups } from "../data/bookmarks";

const total = groups.reduce((n, g) => n + g.links.length, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
---

<Base title="收藏">
  <div class="sheet-page">
    <div class="sheet">
      <a class="back" href={base}>← 书桌</a>

      <div class="head">
        <h1>收藏</h1>
        <span class="count">{total} 条</span>
      </div>
      <p class="lede">存下来的链接，按用处分类。每条写一句为什么存，不然过半年就忘了。</p>

      {
        groups.map((g) => (
          <div class="group">
            <h2>{g.name}</h2>
            {g.links.map((l) => (
              <a class="link" href={l.href} target="_blank" rel="noopener">
                <span class="mark">{l.mark}</span>
                <span>
                  <span class="name">{l.name}</span>
                  <span class="why">{l.why}</span>
                </span>
                <span class="host">{l.host}</span>
              </a>
            ))}
          </div>
        ))
      }

      <p class="foot">链接都是手动加的，加一条就是往 bookmarks 里写一行，跟着网站一起版本管理。</p>
    </div>
  </div>
</Base>

<style is:global>
  .group{ margin-top: 40px; }
  .group h2{
    font-size: 11px; font-weight: 500; letter-spacing: .2em; color: #A8A39A;
    padding-bottom: 9px; border-bottom: 1px solid var(--line);
  }

  .link{
    display: grid;
    grid-template-columns: 26px 1fr auto;
    gap: 16px;
    align-items: baseline;
    padding: 16px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: background .18s;
  }
  .link:hover{ background: rgba(0,0,0,.015); }

  .mark{
    width: 18px; height: 18px;
    border: 1px solid #D5CCB8; border-radius: 2px;
    font-family: var(--brush); font-size: 11px; color: #B3AB9C;
    display: flex; align-items: center; justify-content: center;
    position: relative; top: 2px;
    transition: border-color .18s, color .18s;
  }
  .link:hover .mark{ border-color: var(--stamp); color: var(--stamp); }

  .name{ display: block; font-size: 15.5px; line-height: 1.6; }
  .why{ display: block; margin-top: 4px; font-size: 12.5px; line-height: 1.7; color: #A8A39A; }
  .host{ font-family: var(--brush); font-size: 12px; color: #C0B7A6; letter-spacing: .02em; white-space: nowrap; }
  .link:hover .name{ color: #000; }

  .foot{ margin-top: 34px; font-size: 11.5px; line-height: 1.9; color: #B3AB9C; max-width: 540px; }
</style>
